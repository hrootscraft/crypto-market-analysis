# Crypto Market Pipeline - Environment Variables
# Copy this file to .env and fill in values:
#   cp .env.example .env

# Postgres Data Warehouse
POSTGRES_HOST=warehouse
POSTGRES_DB=crypto
POSTGRES_USER=crypto_user
POSTGRES_PASSWORD=crypto_pass
POSTGRES_PORT=5432

# CoinGecko API
COINGECKO_BASE_URL=https://api.coingecko.com/api/v3

# Number of days of history to backfill on first run
HISTORY_DAYS=90

# Superset (generate with: openssl rand -base64 42)
SUPERSET_SECRET_KEY=supersecret-change-me-in-production
